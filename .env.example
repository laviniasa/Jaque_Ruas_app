# Copie este arquivo para .env.local e preencha. No Render, cole as mesmas variáveis em
# Environment > Environment Variables.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
# Chave de serviço: SÓ no servidor. Nunca coloque NEXT_PUBLIC_ na frente dela.
SUPABASE_SERVICE_ROLE_KEY=

# InfinitePay (pagamento principal)
# InfiniteTag da conta, sem o $ (ex.: jaqueruas)
INFINITEPAY_HANDLE=
# Chave de API (app/site da InfinitePay). Necessária para passar os juros para a aluna e dar validade ao link.
INFINITEPAY_API_KEY=
# Senha que você inventa: vai no endereço do aviso de pagamento para barrar avisos falsos
INFINITEPAY_WEBHOOK_TOKEN=

# Mercado Pago (alternativa; só é usado se a InfinitePay não estiver configurada)
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta dos webhooks (Suas integrações > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

# Endereço público do site (no Render já é descoberto sozinho)
NEXT_PUBLIC_SITE_URL=https://jaqueruas.com.br

# Links dos botões do site
NEXT_PUBLIC_WHATSAPP=5519900000000
NEXT_PUBLIC_GRUPO_DICAS=https://chat.whatsapp.com/SEU-LINK
